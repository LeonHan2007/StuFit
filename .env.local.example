# Supabase (local: run `supabase status` for values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Calendar OAuth (separate from Supabase Auth Google provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local dev sign-in bypass (development only; /auth/dev-login)
DEV_AUTH_EMAIL=dev@stufit.local
DEV_AUTH_PASSWORD=dev-local-only

# Optional: Supabase Auth Google provider (local supabase/config.toml; redirect http://127.0.0.1:54321/auth/v1/callback)
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_CLIENT_SECRET=

# Google Gemini — server-only workout plan generation (create at https://aistudio.google.com/apikey)
# Uses gemini-2.5-flash-lite / gemini-2.5-flash (avoid deprecated 1.5 models)
GEMINI_API_KEY=
