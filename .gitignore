# See https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env (secrets) — keep *.example templates committable
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.keys

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Cursor (local editor config)
.cursor/

# Supabase local CLI (remote migrations in supabase/migrations/ are tracked)
supabase/.branches
supabase/.temp

# OS / tooling
.turbo
.swc
